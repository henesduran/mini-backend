DATABASE_URL=postgres://postgres:changeme@localhost:5432/tasks

# Supabase Auth (W4 assignment) — Project Settings -> API in your Supabase dashboard.
# Use the anon/public key here. Never put the service_role key in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key

# LLM provider (W7 assignment) — Ollama running locally, no account/key needed.
# api key is the literal string "ollama" (required by the SDK, ignored by Ollama).
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=gemma3:1b
LLM_STUB=0
LLM_ENABLED=true